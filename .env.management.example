# Required to enable CRM data and login. Use long unique values; NEVER commit real secrets.
PRINT_ADMIN_PASSWORD=replace-with-a-long-unique-password
PRINT_SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional; defaults to .data in the project's root. Persist and back up this folder.
PRINT_DATA_DIR=.data
# Set true ONLY when serving your app over HTTPS (recommended for production).
PRINT_SECURE_COOKIES=false

# Optional official WhatsApp Business Cloud API integration; keep empty for manual-only mode.
# Never commit real tokens or app secrets.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v24.0
