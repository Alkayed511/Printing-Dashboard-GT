# Local-network admin login: exactly four PIN digits. Never expose this service to the public internet.
# Use an unpredictable PIN. NEVER commit your actual PIN or session secret.
PRINT_ADMIN_PASSWORD=0000 # REPLACE WITH YOUR OWN 4 DIGITS BEFORE RUNNING
PRINT_SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional; defaults to .data in the project's root. Persist and back up this folder.
PRINT_DATA_DIR=.data
# Set true ONLY when serving your app over HTTPS (recommended for production).
PRINT_SECURE_COOKIES=false

# Optional official WhatsApp Business Cloud API integration; keep empty for manual-only mode.
# Never commit real tokens or app secrets.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v24.0

# Optional Google Contacts read-only, click-to-sync via browser OAuth (client ID is public).
# Google Cloud: enable People API, OAuth consent, Web application JS origin http://localhost:3000.
# Do NOT put an OAuth client secret or Google access token here.
GOOGLE_CONTACTS_CLIENT_ID=
