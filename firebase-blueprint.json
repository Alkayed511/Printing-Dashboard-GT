            },
            "printers": {
              "type": "array",
              "description": "List of printers"
            },
            "language": {
              "type": "string"
            },
            "primaryColor": {
              "type": "string"
            },
            "secondaryColor": {
              "type": "string"
            },
            "notificationColor": {
              "type": "string"
            },
            "notificationDuration": {
              "type": "number"
            },
            "localIp": {
              "type": "string"
            },
            "customSoundUrl": {
              "type": "string"
            }
          }
        }
      ]
    }
  ]
}
